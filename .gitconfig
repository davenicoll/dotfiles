#         _ _                   __ _
#    __ _(_) |_ ___ ___  _ __  / _(_) __ _
#   / _` | | __/ __/ _ \| '_ \| |_| |/ _` |
#  | (_| | | || (_| (_) | | | |  _| | (_| |
# (_)__, |_|\__\___\___/|_| |_|_| |_|\__, |
#   |___/                            |___/
#
# Debug Includes with: git config --list --show-origin

[user]
name=
signingKey=""
email=

[init]
defaultBranch=main

[gpg]
program=gpg

[commit]
gpgSign=false

[tag]
forceSignAnnotated=false

[pull]
ff=only

[filter "lfs"]
clean=git-lfs clean -- %f
smudge=git-lfs smudge -- %f
process=git-lfs filter-process
required=true

[push]
autoSetupRemote=true

[core]
editor=nano
pager=less -FRX

[log]
date=iso-local

[branch]
sort=committerdate

[alias]
history=log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all -n 15
pullall="for dir in */ \\\ndo \\\n    dir=${dir%*/} # remove the trailing \"/\" \\\n    echo \"*** Pulling ${dir}\" \\\n    cd $dir \\\n    git pull \\\n    cd .. \\\ndone"
all="!f() { ls -R -d */.git | sed s,/.git,, | xargs -P10 -I{} git -C {} $1; }; f"
reset-to-main=!git reset --hard && git fetch origin && git checkout main && git reset --hard origin/main && git clean -f -d
logline=log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
pr = "!f() { \
        if [ $# -lt 1 ]; then echo 'Usage: git pr <branch> [<url to clone>]'; exit 1; fi; \
        branch=$1; \
        if [ $# -eq 1 ]; then \
            url=$(git config --get remote.origin.url); \
        else \
            url=$2; \
        fi; \
        reponame=$(basename -s .git \"$url\"); \
        if [ $# -eq 1 ]; then \
            root=$(git rev-parse --show-toplevel); \
            parent=$(dirname \"$root\"); \
            folder=\"${parent}/${reponame}_pr_${branch}\"; \
        else \
            folder=\"${reponame}_pr_${branch}\"; \
        fi; \
        git clone -b \"$branch\" \"$url\" \"$folder\"; \
        cd \"$folder\"; \
    }; f"
